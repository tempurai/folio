{
  "name": "folio-memory",
  "version": "0.1.0",
  "type": "module",
  "description": "folio — unified local memory library for AI coding harnesses (file-based, MCP-served). CLI: init, sync, watch, organize, serve.",
  "license": "MIT",
  "keywords": [
    "memory",
    "ai",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "electron",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "folio": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "pnpm --filter @folio/cli... build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@folio/core": "workspace:*",
    "@folio/mcp-server": "workspace:*",
    "chokidar": "4.0.3",
    "commander": "13.1.0",
    "smol-toml": "1.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
